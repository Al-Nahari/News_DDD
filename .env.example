# Copy to .env for local development (never commit the real .env).

SECRET_KEY=
DEBUG=True

# Comma-separated. Required (no wildcard default) once DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Render provides this automatically for its own Postgres instances.
DATABASE_URL=

# Comma-separated list of exact frontend origins allowed to call the API
# from the browser, e.g. https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Only needed if you POST cross-site forms directly (not typical for a
# JSON API consumed by Next.js).
CSRF_TRUSTED_ORIGINS=

# Set to True only once HTTPS is confirmed working end-to-end on Render.
SECURE_SSL_REDIRECT=True

# Used by `python manage.py seed_news` — never used outside local dev.
SEED_PASSWORD=
